# Copy this file to .env and fill in the values, then: chmod 600 .env

# --- Telegram ---
# Create a bot by messaging @BotFather on Telegram -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
# Your personal chat id. After starting the bot once, message it, then visit:
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read result[].message.chat.id
# Or just run: python main.py --whoami   (it prints the chat id of whoever messages it)
TELEGRAM_CHAT_ID=

# --- TickTick OAuth ---
# Register an app at https://developer.ticktick.com/manage  (Manage Apps -> +App Name)
# Set the redirect URI there to EXACTLY match TICKTICK_REDIRECT_URI below.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://localhost:8080/callback
